# =============================================================================
#  InvestBuddy / InfoData — 环境变量模板
#
#  用法：cp .env.example .env  然后按需填写（.env 已被 .gitignore 排除）
#
#  适用范围（2026-10-17 起两处都会读）：
#    ① 本地开发：后端启动时自动加载 .env → 写进进程环境变量
#    ② docker compose：读根 .env 做 ${VAR} 插值
#
#  读取顺序与优先级：
#    进程环境变量  >  backend/.env  >  根 .env  >  代码默认值
#    ⇒ shell 里 export 过同名变量时，.env 里的值**不会生效**（启动日志会警告）。
#
#  两个部署形态的 host 取值不同：
#    模式 A（默认，后端容器连宿主机 MySQL）：INFO_DATA_DB_HOST=host.docker.internal
#    模式 B（全容器化）：INFO_DATA_DB_HOST=mysql / USER=infodata / PASSWORD=你的密码
#    本地直跑（start-dev.*）：INFO_DATA_DB_HOST=127.0.0.1
# =============================================================================

# ---- 数据库连接 ----
# ⚠️ 必须是 MySQL 8.0+：schema.sql 大量使用 utf8mb4_0900_ai_ci，
#    MariaDB 与 MySQL 5.7 会直接建表失败。
INFO_DATA_DB_HOST=host.docker.internal
INFO_DATA_DB_PORT=3306
INFO_DATA_DB_USER=root
INFO_DATA_DB_PASSWORD=root
INFO_DATA_DB_NAME=adata

# ---- 容器版 MySQL（仅模式 B 使用） ----
MYSQL_ROOT_PASSWORD=change_me_strong_password

# ---- 端口与监听地址 ----
# 同一组变量被 start-dev.bat / scripts/start-dev.sh / frontend/vite.config.ts
# 共同读取，三处不会各自漂移。端口冲突时改这里，不必动源码。
# INFO_DATA_API_PORT=8000
# INFO_DATA_WEB_PORT=5173
# INFO_DATA_WEB_HOST=127.0.0.1
# 完整后端地址：前端 dev server 的代理目标，默认 http://127.0.0.1:${API_PORT}
# 指向远程/容器后端时设这个（优先于 API_PORT）
# INFO_DATA_API_TARGET=http://127.0.0.1:8000

# ---- 可选数据源 ----
TUSHARE_TOKEN=

# ---- AI 分析（方舟豆包） ----
ARK_API_KEY=
ARK_MODEL_ID=doubao-1-5-pro-32k-250115

# ============================================================
# 以下为可选配置（未启用时保持注释即可，代码都有默认值）
# ============================================================

# ---- 运行时可调项 ----
# INFO_DATA_DB_CHARSET=utf8mb4      # 连接字符集
# INFO_DATA_DB_POOL=1               # 1=线程内复用长连接（默认）0=每次新建（排查用）
# INFO_DATA_PYTHON=D:\path\to\python.exe   # 解释器绝对路径，优先于 .python-path 与 PATH
# INFO_DATA_SKIP_DOTENV=1           # 跳过 .env 加载（容器已注入环境变量时用）
# NO_PROXY=*                        # 国内数据源直连，绕过本机代理

# ---- 告警通知（旁路功能，不配不影响启动） ----
#   ⚠️ 换机器时最容易漏的一段：漏了**不报错**，只是再也不会收到异动告警。
#   生产建议把凭证放 backend/.env（同样已 gitignore），不要写进本模板。
# INFO_DATA_NOTIFY_PROVIDER=wecom        # wecom | serverchan | pushplus | wxpusher | none
# INFO_DATA_NOTIFY_ON=problems           # problems（仅异常，默认）| always | never
# INFO_DATA_NOTIFY_TIMEOUT=10
# INFO_DATA_WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=<your-key>
# INFO_DATA_SERVERCHAN_KEY=SCT_<your-sendkey>
# INFO_DATA_PUSHPLUS_TOKEN=<your-token>
# INFO_DATA_WXPUSHER_TOKEN=AT_<your-token>
# INFO_DATA_WXPUSHER_UID=UID_<your-uid>

# ---- 提示 ----
# 开发模式（start-dev.bat / start-dev.sh / uvicorn）自 2026-10-17 起**会读 .env**，
# 不再需要 setx。若你仍然习惯用系统环境变量，也没问题 —— 系统环境变量优先级更高。
# 详见根目录 README「环境变量」一节与 backend/app/env.py 文件头。
