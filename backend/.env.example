# =============================================================================
#  backend/.env —— 本机「临时覆盖」用（可选，一般不需要）
#
#  ⚠️ 完整变量清单与说明请改仓库根的 `.env.example`，**不要在这里重复维护**，
#     否则两份模板迟早漂移（这是 2026-10-17 审计时发现的问题之一）。
#
#  两个 .env 的加载顺序（2026-10-17 起支持读 .env 文件）：
#        <仓库根>/.env          先加载
#        backend/.env           后加载 ⇒ **覆盖**根 .env 的同名项
#        进程环境变量           优先级最高，永远压过上面两者
#
#  适用场景举例：
#    - 根 .env 写正式的数据库地址，本机想临时连测试库 ⇒ 只在这里写 DB 三项
#    - 调试通知渠道，不想改正式配置 ⇒ 只在这里写 INFO_DATA_NOTIFY_*
#
#  用法：cp backend/.env.example backend/.env（然后只填需要覆盖的项）
# =============================================================================

# ---- 覆盖示例（按需取消注释） ----
# INFO_DATA_DB_NAME=adata_test
# INFO_DATA_DB_HOST=127.0.0.1
# INFO_DATA_DB_PORT=3306
# INFO_DATA_NOTIFY_PROVIDER=none
# INFO_DATA_DB_POOL=0
