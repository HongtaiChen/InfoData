# 环境变量示例：复制为 .env 并填入真实值
# 数据库（开发期直连本机 MySQL，P5 容器化后改为容器内地址）
INFO_DATA_DB_HOST=127.0.0.1
INFO_DATA_DB_PORT=3306
INFO_DATA_DB_USER=root
INFO_DATA_DB_PASSWORD=root
INFO_DATA_DB_NAME=adata

# Tushare 正规数据源 token（可选，未配置则自动跳过该备源）
TUSHARE_TOKEN=

# 火山引擎方舟（豆包）API Key（可选，AI 概念分析用）
ARK_API_KEY=

# 代理绕过（国内数据源直连，避免本地 HTTP 代理干扰）
NO_PROXY=*
no_proxy=*
